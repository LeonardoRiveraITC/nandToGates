// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    Not(in=sel[1] , out=sel0 );
    And(a=sel0 , b=sel[0] , out=sr1 );
    And(a=sel[0] , b=sel[1] , out=sr2 );

    Mux16(a=a , b=b , sel=sr1 , out=o1 );
    Mux16(a=c , b=d , sel=sr2 , out=o2 );


    Mux16(a=o1 , b=o2 , sel=sel[1] , out=out );
    
}
