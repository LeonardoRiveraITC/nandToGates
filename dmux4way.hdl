// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    //// Replace this comment with your code.
    //And(a=sel[1] , b=sel[0] , out=o34 );
    //Mux(a= , b= , sel=sel[1] , out=oB );
    Mux(a=in , b=false , sel=sel[1] , out=in1 );
    Mux(a=false , b=in , sel=sel[1] , out=in2 );
    

    DMux(in=in1 , sel=sel[0] , a=a , b=b );
    DMux(in=in2 , sel=sel[0] , a=c , b=d );
    

    
    
}
